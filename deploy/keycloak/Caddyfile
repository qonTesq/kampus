{
	email {$ACME_EMAIL}
}

# Keycloak (issuer https://{$AUTH_DOMAIN}/realms/kampus).
{$AUTH_DOMAIN} {
	# The Keycloak admin console is not exposed publicly; use an SSH tunnel:
	#   ssh -L 8180:127.0.0.1:8180 <vm>   then open http://localhost:8180/admin
	@kcadmin path /admin /admin/*
	respond @kcadmin 404
	reverse_proxy keycloak:8080
}

# kampus MCP server on the host. Only the public listener is routed;
# the kampus admin listener (server.admin_listen) stays on loopback.
{$KAMPUS_DOMAIN} {
	@kampusadmin path /admin /admin/*
	respond @kampusadmin 404
	reverse_proxy host.docker.internal:8080
}
