{
  "realm": "kampus",
  "displayName": "kampus demo SSO",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 7200,
  "roles": {
    "realm": [
      {
        "name": "student",
        "description": "Student"
      },
      {
        "name": "faculty",
        "description": "Faculty"
      },
      {
        "name": "staff",
        "description": "Staff"
      },
      {
        "name": "guest",
        "description": "Guest"
      },
      {
        "name": "admin",
        "description": "kampus local administration only (no data access)"
      }
    ]
  },
  "defaultRoles": [],
  "clientScopes": [
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "auth_time",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "false",
            "user.session.note": "AUTH_TIME",
            "claim.name": "auth_time",
            "jsonType.label": "long"
          }
        }
      ]
    },
    {
      "name": "roles",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Your campus roles"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "user.attribute": "foo"
          }
        }
      ]
    },
    {
      "name": "profile",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "kampus-audience",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "kampus audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "${KAMPUS_AUDIENCE}",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "rooms:book",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Confirm (simulated) study-room bookings"
      },
      "protocolMappers": []
    }
  ],
  "defaultDefaultClientScopes": [
    "basic",
    "roles",
    "profile",
    "kampus-audience"
  ],
  "defaultOptionalClientScopes": [
    "rooms:book"
  ],
  "clients": [
    {
      "clientId": "kampus-claude",
      "name": "Claude (school workspace)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KAMPUS_CLAUDE_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "consentRequired": false,
      "redirectUris": [
        "https://claude.ai/api/mcp/auth_callback",
        "https://claude.com/api/mcp/auth_callback",
        "http://localhost:6274/oauth/callback",
        "http://localhost:6274/oauth/callback/debug"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": [
        "basic",
        "roles",
        "profile",
        "kampus-audience"
      ],
      "optionalClientScopes": [
        "rooms:book"
      ]
    },
    {
      "clientId": "kampus-chatgpt",
      "name": "ChatGPT (school workspace)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KAMPUS_CHATGPT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "consentRequired": false,
      "redirectUris": [
        "https://chatgpt.com/connector_platform_oauth_redirect"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": [
        "basic",
        "roles",
        "profile",
        "kampus-audience"
      ],
      "optionalClientScopes": [
        "rooms:book"
      ]
    },
    {
      "clientId": "kampus-mascot",
      "name": "Mascot device (unapproved)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KAMPUS_MASCOT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "access.token.lifespan": "14400",
        "client_credentials.use_refresh_token": "false"
      },
      "defaultClientScopes": [
        "basic",
        "roles",
        "profile",
        "kampus-audience",
        "rooms:book"
      ],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "student-a",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Avery",
      "lastName": "Demo",
      "email": "student-a@demo.invalid",
      "credentials": [
        {
          "type": "password",
          "value": "${KAMPUS_DEMO_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "student"
      ]
    },
    {
      "username": "student-b",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Blake",
      "lastName": "Demo",
      "email": "student-b@demo.invalid",
      "credentials": [
        {
          "type": "password",
          "value": "${KAMPUS_DEMO_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "student"
      ]
    },
    {
      "username": "faculty-a",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Casey",
      "lastName": "Demo",
      "email": "faculty-a@demo.invalid",
      "credentials": [
        {
          "type": "password",
          "value": "${KAMPUS_DEMO_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "faculty"
      ]
    },
    {
      "username": "service-account-kampus-mascot",
      "enabled": true,
      "serviceAccountClientId": "kampus-mascot",
      "realmRoles": [
        "guest"
      ]
    }
  ]
}
