* text=auto eol=lf
*.ps1 text eol=crlf
*.png binary
*.zip binary

# Hardware CAD and print files: stored with Git LFS (run `git lfs install` once)
hardware/**/*.stl filter=lfs diff=lfs merge=lfs -text
hardware/**/*.3mf filter=lfs diff=lfs merge=lfs -text
hardware/**/*.step filter=lfs diff=lfs merge=lfs -text
hardware/**/*.stp filter=lfs diff=lfs merge=lfs -text
hardware/**/*.f3d filter=lfs diff=lfs merge=lfs -text
hardware/**/*.FCStd filter=lfs diff=lfs merge=lfs -text
hardware/**/*.blend filter=lfs diff=lfs merge=lfs -text
hardware/**/*.jpg filter=lfs diff=lfs merge=lfs -text
hardware/**/*.png filter=lfs diff=lfs merge=lfs -text
