# Copy this file to .env and put your own key there, on the Pi.
# Never paste the key into chat or commit it to source control.
GEMINI_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional overrides for the Realtime owl (owl-realtime)
OPENAI_REALTIME_MODEL=
MCP_SERVER_URL=
MCP_AUTHORIZATION=
MCP_ALLOWED_TOOLS=
# Device number or name from: uv run owl-realtime --list-audio  (empty = system default)
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
